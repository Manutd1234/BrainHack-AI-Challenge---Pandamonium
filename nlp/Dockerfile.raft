# Optional RAFT/LoRA NLP image. Use only after train_raft_lora.py writes
# src/lora_adapter. To use with til build, copy this file over Dockerfile.
FROM nvcr.io/nvidia/pytorch:25.11-py3

ARG QWEN_MODEL_ID=Qwen/Qwen2.5-3B-Instruct

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_ROOT_USER_ACTION=ignore \
    QWEN_MODEL_PATH=/app/models/qwen-base \
    QWEN_ENABLE_THINKING=0 \
    NLP_USE_APPROX_LOOKUP=1 \
    NLP_USE_QA_MEMORY=0 \
    NLP_USE_QA_MEMORY_HINTS=0 \
    NLP_USE_DENSE=0 \
    NLP_USE_LLM=1 \
    NLP_LLM_MODE=selective \
    NLP_USE_QA_READER=0 \
    NLP_MAX_MODEL_LEN=2048 \
    NLP_LLM_CONTEXT_CHARS=3600 \
    NLP_MAX_NEW_TOKENS=96 \
    NLP_LORA_ADAPTER_PATH=/app/src/lora_adapter \
    NLP_MAX_GPU_MEMORY=12GiB

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir --upgrade "transformers>=4.51.0"

RUN python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='${QWEN_MODEL_ID}', local_dir='/app/models/qwen-base', local_dir_use_symlinks=False, ignore_patterns=['*.h5','*.onnx','*.msgpack','*.md','*.png','*.pdf'])"

COPY src/ ./src/

WORKDIR /app/src

EXPOSE 5004
CMD ["uvicorn", "nlp_server:app", "--host", "0.0.0.0", "--port", "5004", "--workers", "1"]
